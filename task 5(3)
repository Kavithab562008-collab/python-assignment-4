import csv
 
def write_reports(counts, percentages, three_absent, errors):
    with open("attendance_three_module.csv", "w", newline="", encoding="utf-8") as f:
        w = csv.writer(f); w.writerow(["register", "present", "absent", "percent"])
        for reg, (p, a) in sorted(counts.items()):
            w.writerow([reg, p, a, f"{percentages[reg]:.2f}"])
    with open("absent_three_days.csv", "w", encoding="utf-8") as f:
        f.write("register_number\\n")
        for reg in three_absent: f.write(reg + "\\n")
    with open("attendance_errors.log", "w", encoding="utf-8") as f:
        for error in errors: f.write(str(error) + "\\n")

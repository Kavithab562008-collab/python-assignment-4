from pathlib import Path
 
def read_attendance(folder):
    records, errors = [], []
    for path in sorted(Path(folder).glob("*.csv")):
        try:
            with path.open(encoding="utf-8") as f:
                for no, line in enumerate(f, 1):
                    if not line.strip(): continue
                    fields = [x.strip() for x in line.split(",")]
                    if len(fields) != 3 or fields[2] not in ("P", "A"):
                        errors.append((path.name, no, "Invalid record"))
                    else:
                        records.append(tuple(fields))
        except (OSError, UnicodeDecodeError) as e:
            errors.append((path.name, 0, str(e)))
    return records, errors
stats.py
def calculate(records):
    counts = {}
    history = {}
    for reg, date, status in records:
        counts.setdefault(reg, [0, 0])
        counts[reg][0 if status == "P" else 1] += 1
        history.setdefault(reg, []).append((date, status))
    percentages = {}
    for reg, (present, absent) in counts.items():
        total = present + absent
        percentages[reg] = present * 100 / total if total else 0
    three_absent = []
    for reg, items in history.items():
        statuses = [s for date, s in sorted(items)]
        if any(statuses[i:i+3] == ["A", "A", "A"]
               for i in range(len(statuses)-2)):
            three_absent.append(reg)
    return counts, percentages, three_absent

from reader import read_attendance
from stats import calculate
from report import write_reports
 
if __name__ == "__main__":
    records, errors = read_attendance("daily_files")
    counts, percentages, three_absent = calculate(records)
    write_reports(counts, percentages, three_absent, errors)
    print("Records:", len(records), "Students:", len(counts),
          "Three-day absentees:", len(three_absent), "Errors:", len(errors))

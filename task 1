from decimal import Decimal, InvalidOperation
 
def process_mess_bills(filename):
    total = Decimal("0.00")
    report_rows = []
    rejected = []
 
    try:
        with open(filename, "r", encoding="utf-8") as file:
            for line_number, line in enumerate(file, start=1):
                if not line.strip():          # ignore blank lines
                    continue
                try:
                    parts = [item.strip() for item in line.split(",")]
                    if len(parts) != 3:
                        raise ValueError("Expected 3 comma-separated fields")
 
                    register_no, name, amount_text = parts
                    if not register_no or not name:
                        raise ValueError("Register number/name is empty")
 
                    amount = Decimal(amount_text)
                    if not amount.is_finite() or amount < 0:
                        raise ValueError("Amount must be a non-negative number")
 
                    total += amount
                    report_rows.append(f"{register_no} - {name} - {amount:.2f}")
 
                except (ValueError, InvalidOperation) as error:
                    rejected.append((line_number, line.rstrip("\\n"), str(error)))
 
    except FileNotFoundError:
        print(f"Input file not found: {filename}")
        return [], Decimal("0.00"), [("FILE", filename, "File not found")]
    except PermissionError:
        print(f"Permission denied: {filename}")
        return [], Decimal("0.00"), [("FILE", filename, "Permission denied")]
    except UnicodeDecodeError:
        print(f"Cannot decode file using UTF-8: {filename}")
        return [], Decimal("0.00"), [("FILE", filename, "Encoding error")]
 
    return report_rows, total, rejected
 
 
if __name__ == "__main__":
    rows, total, rejected = process_mess_bills("mess_oct.txt")
    print("MESS BILL REPORT")
    for row in rows:
        print(row)
    print(f"Total: {total:.2f}")
    print("Rejected records:")
    for item in rejected:
        print(item)
